# Copy to dns.env (git-ignored). Files that use these are applied through
# envsubst, naming the variables so nothing else is touched:
#
#   set -a; source cluster/dns.env; set +a
#   envsubst '$DNS_SERVER $DNS_ZONE' < cluster/external-dns.yaml | kubectl apply -f -
#   envsubst '$DNS_SERVER $DNS_ZONE' < cluster/traefik-dns.yaml | kubectl apply -f -

# The BIND server external-dns sends updates to.
DNS_SERVER=ns1.example.com
# The dynamic zone external-dns owns. The app's record is salamendar.$DNS_ZONE.
DNS_ZONE=k8s.example.com
