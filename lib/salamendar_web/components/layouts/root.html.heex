<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Salamendar" suffix=" · Salamendar" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/vendor/event-calendar.min.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- EventCalendar's build is `var EventCalendar = (…)`, which esbuild
    would make private to app.js, so it gets its own tag. `defer` keeps the
    order: it runs before app.js. --%>
    <script defer phx-track-static type="text/javascript" src={~p"/vendor/event-calendar.min.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
